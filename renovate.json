{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardAutoclose": true,
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":approveMajorUpdates",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "automerge": false,
      "description": "Require manual review before merging dependency updates",
      "matchPackageNames": ["*"]
    },
    {
      "matchUpdateTypes": ["major"],
      "reviewers": ["ponharu"]
    }
  ],
  "rangeStrategy": "pin",
  "schedule": ["after 10pm every weekday", "before 3am every weekday"],
  "separateMultipleMajor": true,
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "automerge": false,
    "dependencyDashboardApproval": false,
    "enabled": true,
    "minimumReleaseAge": "0 days"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  }
}
